#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export LANG=C.UTF-8
export LC_ALL=C.UTF-8

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  echo "==> $label"
  "$@"
  echo "<== $label completed in $((SECONDS - started_at))s"
}

if [[ "$(uname -s)" == "Linux" ]] && command -v apt-get >/dev/null 2>&1; then
  if [[ "$(id -u)" -eq 0 ]]; then
    apt=(apt-get)
  elif command -v sudo >/dev/null 2>&1; then
    apt=(sudo apt-get)
  else
    echo "setup requires root or sudo to install Debian packages" >&2
    exit 1
  fi

  export DEBIAN_FRONTEND=noninteractive
  native_packages=(
    build-essential
    ca-certificates
    curl
    fonts-dejavu-core
    git
    mold
    pkg-config
    python3
    unzip
    xz-utils
  )
  missing_packages=()
  for package in "${native_packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fqx "install ok installed"; then
      missing_packages+=("$package")
    fi
  done

  if ((${#missing_packages[@]})); then
    run_step "Refreshing Debian package metadata" "${apt[@]}" update
    run_step "Installing native build prerequisites: ${missing_packages[*]}" \
      "${apt[@]}" install -y --no-install-recommends "${missing_packages[@]}"
  else
    echo "==> Native build prerequisites are already installed"
  fi
fi

if ! command -v mise >/dev/null 2>&1 && [[ ! -x "$HOME/.local/bin/mise" ]]; then
  echo "==> Installing mise"
  # Pinned, checksum-verified release instead of `curl https://mise.run | sh`.
  # Update mise_version and both checksums together.
  mise_version="v2026.6.14"
  case "$(uname -m)" in
    x86_64|amd64)
      mise_arch="x64"
      mise_sha="491dd31ff1e0201c7866046f4110125392a481f0fd37e01e5e622fa12670b77b"
      ;;
    aarch64|arm64)
      mise_arch="arm64"
      mise_sha="947541d82684732cf27327d0d1914b471c0edb5ed6db8507f81b4ad8b67ba7cf"
      ;;
    *)
      echo "unsupported architecture: $(uname -m)" >&2
      exit 1
      ;;
  esac

  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT
  curl -fsSL \
    "https://github.com/jdx/mise/releases/download/${mise_version}/mise-${mise_version}-linux-${mise_arch}-musl.tar.gz" \
    -o "$tmp_dir/mise.tar.gz"
  printf '%s  %s\n' "$mise_sha" "$tmp_dir/mise.tar.gz" | sha256sum -c -
  tar -xzf "$tmp_dir/mise.tar.gz" -C "$tmp_dir"
  mkdir -p "$HOME/.local/bin"
  install "$tmp_dir/mise/bin/mise" "$HOME/.local/bin/mise"
fi
export PATH="$HOME/.local/bin:$PATH"

profile_marker="# the-gathering orb tools"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# the-gathering orb tools
export PATH="$HOME/.local/bin:$PATH"
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
EOF
fi

# Commits must be authored by the thread's user only: no Amp co-author and no
# Amp-Thread trailer. Set both the Amp settings and the equivalent environment
# variables so the policy holds even if settings.json is later rewritten.
commit_marker="# the-gathering commit trailers"
if ! grep -Fqx "$commit_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# the-gathering commit trailers
export AMP_DISABLE_AMP_COAUTHOR_TRAILER=1
export AMP_DISABLE_AMP_THREAD_TRAILER=1
EOF
fi

amp_settings="$HOME/.config/amp/settings.json"
mkdir -p "$(dirname "$amp_settings")"
python3 - "$amp_settings" <<'PY'
import json
import os
import sys
import tempfile

path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as settings_file:
        settings = json.load(settings_file)
except FileNotFoundError:
    settings = {}

settings["amp.git.commit.ampThread.enabled"] = False
settings["amp.git.commit.coauthor.enabled"] = False
directory = os.path.dirname(path)
with tempfile.NamedTemporaryFile("w", dir=directory, delete=False, encoding="utf-8") as output:
    json.dump(settings, output, indent=2)
    output.write("\n")
    temporary_path = output.name
os.replace(temporary_path, path)
PY

amp_guidance="$HOME/.config/amp/AGENTS.md"
amp_guidance_marker="# the-gathering mise command guidance"
mkdir -p "$(dirname "$amp_guidance")"
if ! grep -Fqx "$amp_guidance_marker" "$amp_guidance" 2>/dev/null; then
  cat >> "$amp_guidance" <<'EOF'

# the-gathering mise command guidance
When working in The Gathering repository, invoke project-managed tools through mise from the first command onward: `mise exec -- cargo ...` (in `rust/`), `mise run ...`, `mise exec -- aube ...`, `mise exec -- aube exec vp ...`. Fresh orbs do not expose cargo, aube, or vp directly on PATH.
EOF
fi

mise trust --quiet "$repo_root/mise.toml"
run_step "Installing the pinned toolchain (Rust, SQLite, Node, aube)" mise install -y

run_step "Installing JavaScript dependencies" \
  mise exec -- aube install --frozen-lockfile

# Build the server and its tests against the committed sqlx metadata so the first
# `mise run dev` / `mise run test` starts quickly. This stays incremental (unlike CI and the
# release builds): it is the cache the next edit-and-build in this orb reuses.
run_step "Building the Rust server and tests" \
  bash -c 'cd rust && mise exec -- cargo build --locked --bin the-gathering && mise exec -- cargo test --locked --no-run'

run_step "Migrating and seeding the development database" \
  env THE_GATHERING_ENV=dev bash -c 'rust/target/debug/the-gathering migrate && rust/target/debug/the-gathering seed'

echo "==> The Gathering orb setup complete"
