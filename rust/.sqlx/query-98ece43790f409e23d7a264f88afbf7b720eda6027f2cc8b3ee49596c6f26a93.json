  "query": "SELECT id AS \"id!: i64\", external_id, guild_id, channel_id,\n                      played_at AS \"played_at: UtcDateTime\", players, raw,\n                      inserted_at AS \"inserted_at: UtcDateTime\", updated_at AS \"updated_at: UtcDateTime\"\n               FROM pending_discord_games AS pending WHERE NOT EXISTS (SELECT 1 FROM games WHERE games.source = 'discord' AND games.external_id = pending.external_id)\n         ORDER BY played_at DESC, id DESC",
