# Copy to .env next to docker-compose.yml.

# Required. Generate with: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=

# Public address users reach the app at. Behind a TLS reverse proxy use
# PHX_HOST=games.example.com PHX_SCHEME=https PHX_URL_PORT=443
PHX_HOST=localhost
PHX_SCHEME=http
PHX_URL_PORT=4000

# Optional Discord game tracking. Leave DISCORD_BOT_TOKEN blank to disable it.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SPELLBOT_USER_ID=725510263251402832
