# Copy to .env next to docker-compose.yml.
# Card images need no configuration: DATA_DIR/card-images (Docker /data/card-images)
# is a disposable 512 MiB cache, oldest-written eviction, 30-day expiry.

# Required. Generate with: openssl rand -base64 64 | tr -d '\n'
# (Releases up to 0.2 called this SECRET_KEY_BASE; that name still works but logs a warning.)
THE_GATHERING_SECRET_KEY=

# Public address users reach the app at, used for generated links and the Discord
# OAuth redirect. Behind a TLS reverse proxy use, for example,
# THE_GATHERING_PUBLIC_URL=https://games.example.com
# (Replaces PHX_SCHEME, PHX_HOST, and PHX_URL_PORT, which still work with a warning.)
THE_GATHERING_PUBLIC_URL=http://localhost:4000
# Set to true behind a reverse proxy that sets x-real-ip / x-forwarded-for, so
# login rate limiting counts real client addresses instead of the proxy.
TRUST_PROXY_HEADERS=

# Updating from the admin UI ("Update now" under Administration > Server
# settings). Docker only; the Proxmox LXC installer wires this up on its own.
# COMPOSE_PROFILES=self-update starts a Watchtower container next to the app;
# the token lets the app ask it to pull the image tag the container was started
# from and recreate the container. Generate with: openssl rand -hex 32
# Leave both blank to keep the button hidden.
COMPOSE_PROFILES=
WATCHTOWER_HTTP_API_TOKEN=

# Optional read-only correction export for the training desktop. Generate with
# openssl rand -hex 32; bind to an enabled administrator's numeric user ID.
CARDID_CORRECTIONS_TOKEN=
CARDID_CORRECTIONS_ADMIN_ID=

# WebRTC NAT traversal for webcam tables. STUN defaults to public servers
# (Google and Cloudflare) so internet rooms connect through ordinary home
# routers; set WEBRTC_STUN_URLS=none for a LAN-only install. Players behind
# strict/symmetric NAT or CGNAT also need a TURN relay. URLs are comma-separated.
# TURN must be reachable directly (including UDP/TCP/TLS), not only through the
# app's HTTP reverse proxy.
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Or let Cloudflare Realtime relay: create a TURN key in the Cloudflare dashboard
# (Realtime > TURN) and paste its ID and API token. Each room join then gets
# credentials that expire after CLOUDFLARE_TURN_TTL_SECONDS (default 6 hours).
# First 1,000 GB/month of relayed traffic is free, then $0.05/GB.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# The webcam table SFU receives every seat's video on UDP ports in this range
# (default 50000-50100). Forward them from your router to this host and set
# WEBRTC_SFU_PUBLIC_IP to the address players reach them at. Hosts that cannot
# forward ports can set WEBRTC_SFU_RELAY_ONLY=true to use the Cloudflare TURN
# relay above instead.
WEBRTC_SFU_PORT_RANGE=
WEBRTC_SFU_PUBLIC_IP=
WEBRTC_SFU_IPV6=
WEBRTC_SFU_RELAY_ONLY=

# Optional self-hosted ManaVault instance, e.g. https://manavault.example.com.
# Leave blank to treat ManaVault links as plain deck links.
MANAVAULT_URL=

# Personal ManaVault deck listing requires HTTPS and blocks private, loopback,
# link-local, and Tailscale addresses by default. Comma-separated exact hostnames
# here may use private addresses and HTTP. Allow HTTP for all otherwise-public
# hosts only when MANAVAULT_ALLOW_INSECURE_URLS=true.
MANAVAULT_ALLOWED_HOSTS=
MANAVAULT_ALLOW_INSECURE_URLS=

# Discord OAuth member sign-in. Create credentials in the same Discord
# application used by the optional bot and register this redirect URI:
# <THE_GATHERING_PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional Discord game tracking. Leave DISCORD_BOT_TOKEN blank to disable it.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# IANA timezone for /newgame bare clock times. Discord displays times locally.
DISCORD_DEFAULT_TIMEZONE=America/New_York
DISCORD_SPELLBOT_USER_ID=725510263251402832
